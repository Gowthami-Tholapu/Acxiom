# Application Configuration
PROJECT_NAME="AcxiomCRM"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="acxiomcrm-super-secret-jwt-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Database (MySQL production standard, or SQLite for local dev/testing)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="mysql+pymysql://crm_user:crm_password@localhost:3306/acxiom_crm"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Cookie Settings
COOKIE_NAME="access_token"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"
